# ==============================================================================
#                      CONFIGURAÇÃO DO BOT DISCORD THALHURIA
# ==============================================================================

# Token do Bot gerado no Discord Developer Portal (https://discord.com/developers/applications)
# IMPORTANTE: No Developer Portal, ative em "Privileged Gateway Intents":
# - SERVER MEMBERS INTENT
# - MESSAGE CONTENT INTENT
DISCORD_TOKEN=seu_discord_bot_token_aqui

# (Opcional) ID da Guilda de Testes para registrar comandos Slash instantaneamente
# Se deixado em branco, os comandos serão registrados apenas globalmente (pode levar alguns minutos)
TEST_GUILD_ID=

# Caminho do arquivo de template do servidor (padrão: server-template.json)
TEMPLATE_PATH=server-template.json

# Caminho do banco de dados SQLite para persistência dos IDs mapeados (padrão: data/server_map.db)
DATABASE_PATH=data/server_map.db

# (Opcional) Pasta de templates por servidor: templates/<ID_DO_SERVIDOR>.json substitui o padrão naquele servidor
TEMPLATES_DIR=templates

# (Opcional) Pasta onde o /backup salva cópias do servidor
BACKUPS_DIR=backups

# (Opcional) Registrar o CONTEÚDO de mensagens apagadas/editadas nos logs de moderação.
# Antes de ligar, ative "MESSAGE CONTENT INTENT" no Developer Portal — senão o bot não consegue conectar.
MESSAGE_CONTENT_INTENT=false
